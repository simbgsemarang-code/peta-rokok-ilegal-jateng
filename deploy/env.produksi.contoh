# Templat .env untuk produksi. pasang.sh menyalinnya ke web/.env, mengisi sandi database, APP_URL, dan APP_KEY.
# Jangan pernah meng-commit web/.env.
APP_NAME="Peta Rokok Ilegal Jateng"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Basis data PostgreSQL + PostGIS di server yang sama; hanya menerima koneksi lokal
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=peta_rokok_ilegal
DB_USERNAME=peta_app
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log

# ---- Situs publik (lihat config/publik.php) ----
PUBLIK_INSTANSI="Satpol PP Provinsi Jawa Tengah"
PUBLIK_UNIT="Bidang Penegakan Peraturan Perundang-undangan Daerah (Gakkumda)"
# Setel false bila angka penindakan belum boleh tampil ke publik
PUBLIK_TAMPILKAN_DATA=true
# Kanal pengaduan resmi: isi setelah ditetapkan instansi (kosong = halaman Kontak menyatakan akan diumumkan)
PUBLIK_ALAMAT=
PUBLIK_TELEPON=
PUBLIK_WHATSAPP=
PUBLIK_EMAIL=
PUBLIK_SITUS=
PUBLIK_JAM_LAYANAN=
PUBLIK_TAUTAN_PENGADUAN=
